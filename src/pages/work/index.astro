---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import FeaturedWorkEmbed from '../../components/FeaturedWorkEmbed.astro';
import CTASection from '../../components/CTASection.astro';
import RevealOnScroll from '../../components/RevealOnScroll.astro';
import { siteConfig } from '../../content/site.config';
import { t } from '../../i18n/utils';

const locale = 'en';
---

<BaseLayout title={t(locale, 'work.pageTitle')} description={t(locale, 'work.pageSubtitle')} locale={locale}>
  <div class="pt-20"></div>
  <Section>
    <div class="mb-16 reveal-on-scroll">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-semibold">{t(locale, 'work.pageTitle')}</h1>
    </div>
    {siteConfig.work.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {siteConfig.work.map((work, i) => (
          <FeaturedWorkEmbed work={work} locale={locale} index={i} />
        ))}
      </div>
    ) : (
      <div class="reveal-on-scroll">
        <div class="wrapper">
          <div class="frame-container">
            <iframe 
              src="https://www.youtube.com/embed/IGORD8Gu6ug?rel=0&controls=0&modestbranding=1&autohide=1&autoplay=0&mute=1&loop=1&playlist=IGORD8Gu6ug&iv_load_policy=3&cc_load_policy=0&disablekb=1&fs=0&vq=hd1080p&showinfo=0" 
              title="Video" 
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
              allowfullscreen
              id="youtube-iframe"
            ></iframe>
          </div>
        </div>
      </div>
      <style>
        .wrapper {
          max-width: 100%;
          position: relative;
          width: 50%;
          overflow: hidden;
          border-radius: 0.5rem;
          box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
        }
        .frame-container {
          position: relative;
          padding-bottom: 56.25%;
          width: 150%;
          left: -25%;
          min-width: 150%;
        }
        .frame-container iframe {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          border: none;
          cursor: pointer;
        }
        @media (max-width: 768px) {
          .wrapper {
            width: 75%;
          }
          .frame-container {
            width: 180%;
            left: -40%;
            min-width: 180%;
          }
        }
        @media (max-width: 480px) {
          .wrapper {
            width: 100%;
          }
          .frame-container {
            width: 200%;
            left: -50%;
            min-width: 200%;
          }
        }
      </style>
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          const iframe = document.getElementById('youtube-iframe');
          
          iframe.addEventListener('click', function() {
            const currentSrc = iframe.src;
            if (!currentSrc.includes('autoplay=1')) {
              iframe.src = currentSrc.replace('autoplay=0', 'autoplay=1');
            }
          });
        });
      </script>
    )}
  </Section>
  <CTASection locale={locale} />
  <RevealOnScroll />
</BaseLayout>
