---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import FeaturedWorkEmbed from '../../components/FeaturedWorkEmbed.astro';
import CTASection from '../../components/CTASection.astro';
import RevealOnScroll from '../../components/RevealOnScroll.astro';
import { siteConfig, getLocalizedString } from '../../content/site.config';
import { t } from '../../i18n/utils';

const locale = 'en';
---

<BaseLayout title={t(locale, 'work.pageTitle')} description={t(locale, 'work.pageSubtitle')} locale={locale}>
  <div class="pt-20"></div>
  <Section>
    <div class="mb-16 reveal-on-scroll">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-semibold">{t(locale, 'work.pageTitle')}</h1>
    </div>
    {siteConfig.work.length > 0 ? (
      <div class="work-grid">
        {siteConfig.work.map((work, i) => (
          <div class="work-tile reveal-on-scroll" style={`--delay: ${i * 0.1}s`}>
            <div class="video-container">
              <video 
                class="work-video"
                muted
                loop
                playsInline
                playsinline
                poster={work.coverImage}
                data-slug={work.slug}
              >
                <source src={work.videoFile} type="video/mp4">
                {work.videoFileHEVC && <source src={work.videoFileHEVC} type="video/mp4; codecs=hev1">}
                Your browser does not support the video tag.
              </video>
              <div class="video-overlay">
                <div class="work-info">
                  <h3 class="work-title">{getLocalizedString(work.title, locale)}</h3>
                  <p class="work-category">{getLocalizedString(work.category, locale)}</p>
                  {work.year && <p class="work-year">{work.year}</p>}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="work-grid">
        <div class="work-tile reveal-on-scroll" style="--delay: 0s">
          <div class="video-container">
            <video 
              class="work-video"
              muted
              loop
              playsInline
              playsinline
              poster={siteConfig.heroPoster}
              data-slug="hero"
            >
              <source src={siteConfig.heroVideo} type="video/mp4" playsinline>
              {siteConfig.heroVideoHEVC && <source src={siteConfig.heroVideoHEVC} type="video/mp4; codecs=hev1" playsinline>}
              Your browser does not support the video tag.
            </video>
            <div class="video-overlay">
              <div class="work-info">
                <h3 class="work-title">Hero Reel</h3>
                <p class="work-category">Brand Film</p>
                <p class="work-year">2024</p>
              </div>
            </div>
          </div>
        </div>
        <div class="work-tile reveal-on-scroll" style="--delay: 0.1s">
          <div class="video-container">
            <video 
              class="work-video"
              muted
              loop
              playsInline
              playsinline
              poster={siteConfig.heroPoster}
              data-slug="sample-1"
            >
              <source src={siteConfig.heroVideo} type="video/mp4" playsinline>
              {siteConfig.heroVideoHEVC && <source src={siteConfig.heroVideoHEVC} type="video/mp4; codecs=hev1" playsinline>}
              Your browser does not support the video tag.
            </video>
            <div class="video-overlay">
              <div class="work-info">
                <h3 class="work-title">Campaign Film</h3>
                <p class="work-category">Commercial</p>
                <p class="work-year">2024</p>
              </div>
            </div>
          </div>
        </div>
        <div class="work-tile reveal-on-scroll" style="--delay: 0.2s">
          <div class="video-container">
            <video 
              class="work-video"
              muted
              loop
              playsInline
              playsinline
              poster={siteConfig.heroPoster}
              data-slug="sample-2"
            >
              <source src={siteConfig.heroVideo} type="video/mp4" playsinline>
              {siteConfig.heroVideoHEVC && <source src={siteConfig.heroVideoHEVC} type="video/mp4; codecs=hev1" playsinline>}
              Your browser does not support the video tag.
            </video>
            <div class="video-overlay">
              <div class="work-info">
                <h3 class="work-title">Fashion Story</h3>
                <p class="work-category">Fashion Film</p>
                <p class="work-year">2023</p>
              </div>
            </div>
          </div>
        </div>
        <div class="work-tile reveal-on-scroll" style="--delay: 0.3s">
          <div class="video-container">
            <video 
              class="work-video"
              muted
              loop
              playsInline
              playsinline
              poster={siteConfig.heroPoster}
              data-slug="sample-3"
            >
              <source src={siteConfig.heroVideo} type="video/mp4" playsinline>
              {siteConfig.heroVideoHEVC && <source src={siteConfig.heroVideoHEVC} type="video/mp4; codecs=hev1" playsinline>}
              Your browser does not support the video tag.
            </video>
            <div class="video-overlay">
              <div class="work-info">
                <h3 class="work-title">Tech Innovation</h3>
                <p class="work-category">Technology</p>
                <p class="work-year">2023</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    )}
    <style>
      .work-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        margin-top: 3rem;
        justify-items: start; /* Align items to the start (left) of each grid cell */
      }
      
      .work-tile {
        opacity: 0;
        transform: translateY(30px) scale(0.95);
        animation: revealTile 0.8s ease-out forwards;
        animation-delay: var(--delay);
        max-width: 500px;
        width: 100%; /* Ensure tiles take full width of their grid cell */
        justify-self: start; /* Align to the left within the grid cell */
      }
      
      @keyframes revealTile {
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }
      
      .video-container {
        position: relative;
        aspect-ratio: 16/9;
        border-radius: 1rem;
        overflow: hidden;
        background: #000;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      }
      
      .video-container:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
      }
      
      .work-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: all 0.4s ease;
      }
      
      .video-container:hover .work-video {
        transform: scale(1.1);
        filter: brightness(0.7);
      }
      
      .video-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        background: transparent;
        opacity: 0;
        transition: all 0.4s ease;
      }
      
      .video-container:hover .video-overlay {
        opacity: 1;
      }
      
      .play-icon {
        width: 4rem;
        height: 4rem;
        background: rgba(255, 255, 255, 0.9);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        transform: scale(0.8);
        transition: all 0.4s ease;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      }
      
      .play-icon svg {
        width: 2rem;
        height: 2rem;
        color: #000;
        margin-left: 0.25rem;
      }
      
      .video-container:hover .play-icon {
        transform: scale(1);
        background: rgba(255, 255, 255, 1);
      }
      
      /* Hide overlay in fullscreen to show native controls */
      .video-container:fullscreen .video-overlay,
      .video-container:-webkit-full-screen .video-overlay,
      .video-container:-moz-full-screen .video-overlay,
      .video-container:-ms-fullscreen .video-overlay {
        display: none !important;
      }
      
      /* Ensure video takes full space in fullscreen */
      .video-container:fullscreen .work-video,
      .video-container:-webkit-full-screen .work-video,
      .video-container:-moz-full-screen .work-video,
      .video-container:-ms-fullscreen .work-video {
        width: 100vw !important;
        height: 100vh !important;
        object-fit: contain !important;
        transform: none !important;
        filter: none !important;
      }
      
      /* Reset container styles in fullscreen */
      .video-container:fullscreen,
      .video-container:-webkit-full-screen,
      .video-container:-moz-full-screen,
      .video-container:-ms-fullscreen {
        border-radius: 0 !important;
        transform: none !important;
        box-shadow: none !important;
      }
      
      .work-info {
        text-align: center;
        color: white;
        transform: translateY(20px);
        transition: all 0.4s ease;
      }
      
      .video-container:hover .work-info {
        transform: translateY(0);
      }
      
      .work-title {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
      }
      
      .work-category {
        font-size: 1rem;
        opacity: 0.9;
        margin-bottom: 0.25rem;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
      }
      
      .work-year {
        font-size: 0.875rem;
        opacity: 0.7;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
      }
      
      .fullscreen-btn {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: rgba(0, 0, 0, 0.7);
        border: none;
        border-radius: 50%;
        width: 2.5rem;
        height: 2.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: white;
        transition: all 0.2s ease;
        opacity: 0;
        transform: scale(0.8);
      }
      
      .video-container:hover .fullscreen-btn {
        opacity: 1;
        transform: scale(1);
      }
      
      .fullscreen-btn:hover {
        background: rgba(0, 0, 0, 0.9);
        transform: scale(1.1);
      }
      
      .fullscreen-btn svg {
        width: 1.25rem;
        height: 1.25rem;
      }
      
      @media (max-width: 768px) {
        .work-grid {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }
        
        .work-tile {
          max-width: none;
        }
        
        .video-container:hover {
          transform: translateY(-4px) scale(1.01);
        }
        
        .play-icon {
          width: 3rem;
          height: 3rem;
        }
        
        .play-icon svg {
          width: 1.5rem;
          height: 1.5rem;
        }
        
        .work-title {
          font-size: 1.25rem;
        }
        
        .fullscreen-btn {
          width: 2rem;
          height: 2rem;
        }
        
        .fullscreen-btn svg {
          width: 1rem;
          height: 1rem;
        }
      }
      
      @media (max-width: 480px) {
        .work-grid {
          gap: 1rem;
        }
        
        .video-container:hover {
          transform: translateY(-2px);
        }
      }
    </style>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const workTiles = document.querySelectorAll('.work-tile');
        
        workTiles.forEach(tile => {
          const video = tile.querySelector('.work-video');
          const container = tile.querySelector('.video-container');
          
          // Store initial poster
          const originalPoster = video.getAttribute('poster') || '';
          
          // Simple hover to play
          container.addEventListener('mouseenter', function() {
            if (video && video.paused) {
              video.play().catch(e => console.log('Video play failed:', e));
              video.removeAttribute('poster');
            }
          });
          
          // Simple hover out to pause and restore poster
          container.addEventListener('mouseleave', function() {
            if (video && !video.paused) {
              video.pause();
              video.currentTime = 0;
            }
            video.setAttribute('poster', originalPoster);
            video.load(); // Force reload to show poster
          });
          
          // Click to fullscreen
          container.addEventListener('click', function(e) {
            handleVideoFullscreen(video, e);
          });
          
          // Touch events for mobile
          container.addEventListener('touchend', function(e) {
            e.preventDefault(); // Prevent mouse click simulation
            // For mobile, try to play video first, then handle fullscreen
            if (video && video.paused) {
              video.play().catch(e => console.log('Video play failed:', e));
              video.removeAttribute('poster');
            }
            handleVideoFullscreen(video, e);
            
            // Reset visual feedback
            container.style.transform = '';
          });
          
          // Add touchstart for better mobile interaction
          container.addEventListener('touchstart', function(e) {
            // Visual feedback for touch
            container.style.transform = 'scale(0.98)';
          });
          
          function handleVideoFullscreen(video, event) {
            if (video) {
              // Store current time before fullscreen
              const currentTimeBeforeFullscreen = video.currentTime;
              
              if (video.paused) {
                video.play().catch(e => console.log('Video play failed:', e));
                video.removeAttribute('poster');
              }
              
              // Add controls for better mobile experience
              video.setAttribute('controls', '');
              
              // Try fullscreen with better mobile support
              try {
                if (video.requestFullscreen) {
                  video.requestFullscreen();
                } else if (video.webkitRequestFullscreen) {
                  video.webkitRequestFullscreen();
                } else if (video.webkitEnterFullscreen) {
                  // iOS Safari alternative
                  video.webkitEnterFullscreen();
                } else if (video.msRequestFullscreen) {
                  video.msRequestFullscreen();
                }
              } catch (error) {
                console.log('Fullscreen failed:', error);
                // Fallback: just play the video with controls
                if (video.paused) {
                  video.play().catch(e => console.log('Video play failed:', e));
                }
              }
              
              // Restore time after a short delay (some browsers reset time on fullscreen)
              setTimeout(() => {
                if (Math.abs(video.currentTime - currentTimeBeforeFullscreen) > 1) {
                  video.currentTime = currentTimeBeforeFullscreen;
                }
              }, 100);
            }
          }
          
          // Handle video end
          video.addEventListener('ended', function() {
            video.setAttribute('poster', originalPoster);
            video.currentTime = 0;
            video.load(); // Force reload to show poster
          });
          
          // Handle play/pause events for mobile controls visibility
          video.addEventListener('play', function() {
            // Show controls when playing (both desktop and mobile)
            if (!document.fullscreenElement) {
              video.setAttribute('controls', '');
            }
          });
          
          video.addEventListener('pause', function() {
            // Hide controls when paused on mobile (not fullscreen)
            if (!document.fullscreenElement) {
              // Check if mobile device
              const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
              if (isMobile) {
                video.removeAttribute('controls');
              }
            }
          });
          
          // Handle fullscreen exit
          video.addEventListener('fullscreenchange', function() {
            if (!document.fullscreenElement) {
              // Remove controls when exiting fullscreen
              video.removeAttribute('controls');
              video.setAttribute('poster', originalPoster);
              if (video.paused) {
                video.currentTime = 0;
                video.load(); // Force reload to show poster
              }
            } else {
              // In fullscreen, add tap-to-toggle controls
              let controlsTimeout;
              
              function showControlsTemporarily() {
                video.setAttribute('controls', '');
                clearTimeout(controlsTimeout);
                controlsTimeout = setTimeout(() => {
                  if (document.fullscreenElement) {
                    video.removeAttribute('controls');
                  }
                }, 3000); // Hide after 3 seconds
              }
              
              // Add tap listener to toggle controls in fullscreen
              video.addEventListener('click', function toggleControls(e) {
                if (document.fullscreenElement) {
                  e.stopPropagation();
                  if (video.hasAttribute('controls')) {
                    video.removeAttribute('controls');
                    clearTimeout(controlsTimeout);
                  } else {
                    showControlsTemporarily();
                  }
                }
              });
              
              // Show controls initially when entering fullscreen
              showControlsTemporarily();
            }
          });
        });
      });
    </script>
  </Section>
  <CTASection locale={locale} />
  <RevealOnScroll />
</BaseLayout>
