---
import { siteConfig } from '../content/site.config';
import { t, type Locale } from '../i18n/utils';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hasBrands = siteConfig.brands.length > 0;
---

{hasBrands && <section class="section-olive py-8 md:py-10 px-2 lg:px-4">
  <div class="mx-auto max-w-full">
    <p class="text-center text-xs md:text-sm uppercase tracking-[0.25em] opacity-60 mb-6 md:mb-8">{t(locale, 'trustedBy')}</p>
    <div class="flex items-center justify-center gap-4 md:gap-6 brands-container">
      {siteConfig.brands.map((brand) => (
        <img
          src={`${base}${brand.image}`}
          alt={brand.name}
          class={`brand-logo ${brand.image.includes('magyar_autoklub_logo_ALAP') ? 'zoom-in' : ''} ${brand.image.includes('mupa_logo_black') ? 'zoom-out' : ''}`}
          loading="lazy"
          draggable="false"
        />
      ))}
    </div>
  </div>
</section>}

<style>
  .brands-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  @media (min-width: 768px) {
    .brands-container {
      gap: 24px;
    }
  }
  /* Switch to column at specific breakpoint - no in-between wrapping */
  @media (max-width: 600px) {
    .brands-container {
      flex-direction: column;
      gap: 16px;
    }
  }
  .brand-logo {
    width: 180px;
    height: 90px;
    object-fit: contain;
    display: block;
    opacity: 0.88;
    transition: opacity 0.3s ease, transform 0.3s ease;
    filter: brightness(0) invert(1);
    flex-shrink: 0;
  }
  /* Medium screens - shrink logos */
  @media (max-width: 1024px) {
    .brand-logo {
      width: 160px;
      height: 80px;
    }
  }
  /* Small desktop/large tablet - shrink more */
  @media (max-width: 768px) {
    .brand-logo {
      width: 140px;
      height: 70px;
    }
  }
  /* Switch to column - make logos slightly larger for better visibility */
  @media (max-width: 600px) {
    .brand-logo {
      width: 150px;
      height: 75px;
    }
  }
  .brand-logo:hover {
    opacity: 1 !important;
    transform: translateY(-2px) !important;
  }
  .zoom-in {
    transform: scale(1.15) !important;
  }
  .zoom-out {
    transform: scale(0.85) !important;
  }
  .zoom-in:hover {
    transform: scale(1.15) translateY(-2px) !important;
  }
  .zoom-out:hover {
    transform: scale(0.85) translateY(-2px) !important;
  }
</style>
