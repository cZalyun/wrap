---
import { siteConfig } from '../content/site.config';
import { t, type Locale } from '../i18n/utils';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hasBrands = siteConfig.brands.length > 0;
---

{hasBrands && <section class="section-olive py-8 md:py-10 px-6 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <p class="text-center text-xs md:text-sm uppercase tracking-[0.25em] opacity-60 mb-6 md:mb-8">{t(locale, 'trustedBy')}</p>
    <div class="flex flex-wrap items-center justify-center gap-4 md:gap-6">
      {siteConfig.brands.map((brand) => (
        <div class="brand-card">
          <img
            src={`${base}${brand.image}`}
            alt={brand.name}
            class="brand-logo"
            loading="lazy"
            draggable="false"
          />
        </div>
      ))}
    </div>
  </div>
</section>}

<style>
  .brand-card {
    background: #ffffff;
    border-radius: 8px;
    width: 200px;
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px 20px;
    opacity: 0.88;
    transition: opacity 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }
  .brand-card:hover {
    opacity: 1;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
  }
  .brand-logo {
    max-width: 100%;
    max-height: 60px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }
</style>
