---
import { siteConfig } from '../content/site.config';
import { t, type Locale } from '../i18n/utils';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hasBrands = siteConfig.brands.length > 0;
---

{hasBrands && <section class="section-olive py-8 md:py-10 px-2 lg:px-4">
  <div class="mx-auto max-w-7xl">
    <p class="text-center text-xs md:text-sm uppercase tracking-[0.25em] opacity-60 mb-6 md:mb-8">{t(locale, 'trustedBy')}</p>
    <div class="brands-grid">
      {siteConfig.brands.map((brand) => (
        <img
          src={`${base}${brand.image}`}
          alt={brand.name}
          class={`brand-logo ${brand.image.includes('magyar_autoklub_logo_ALAP') ? 'zoom-in' : ''} ${brand.image.includes('mupa_logo_black') ? 'zoom-out' : ''}`}
          loading="lazy"
          draggable="false"
        />
      ))}
    </div>
  </div>
</section>}

<style>
  .brands-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    max-width: 100%;
  }
  
  /* Desktop: Single row with even spacing */
  @media (min-width: 769px) {
    .brands-grid {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 0;
      justify-content: space-between;
      padding: 0 2rem;
    }
  }
  
  /* Mobile/Tablet: Single column */
  @media (max-width: 768px) {
    .brands-grid {
      flex-direction: column;
      gap: 2rem;
    }
  }
  
  .brand-logo {
    flex-shrink: 0;
    object-fit: contain;
    display: block;
    opacity: 0.88;
    transition: opacity 0.3s ease, transform 0.3s ease;
    filter: brightness(0) invert(1);
  }
  
  /* Desktop: Smaller logos to fit in one row */
  @media (min-width: 769px) {
    .brand-logo {
      height: 50px;
      width: auto;
      max-width: 120px;
    }
  }
  
  /* Mobile/Tablet: Larger logos for single column */
  @media (max-width: 768px) {
    .brand-logo {
      height: 80px;
      width: auto;
      max-width: 180px;
    }
  }
  
  .brand-logo:hover {
    opacity: 1 !important;
    transform: translateY(-2px) !important;
  }
  
  .zoom-in {
    transform: scale(1.35) !important;
  }
  
  .zoom-out {
    transform: scale(0.85) !important;
  }
  
  .zoom-in:hover {
    transform: scale(1.35) translateY(-2px) !important;
  }
  
  .zoom-out:hover {
    transform: scale(0.85) translateY(-2px) !important;
  }
</style>
