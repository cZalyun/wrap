---
import { siteConfig, getLocalizedString } from '../content/site.config';
import { type Locale } from '../i18n/utils';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const paragraphs = getLocalizedString(siteConfig.introText, locale).split('\n\n');
const still = siteConfig.homeDefinitionStill;
---

<section class="section-cream section-padding px-6 lg:px-8">
  <div class="mx-auto max-w-7xl reveal-on-scroll">
    <div class:list={[still && 'grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center']}>
      <div>
        <div class="mb-8">
          <img src={`${base}${siteConfig.logoDark}`} alt={siteConfig.brand} class="logo-light-mode h-20 md:h-28 w-auto hidden" />
          <img src={`${base}${siteConfig.logoLight}`} alt={siteConfig.brand} class="logo-dark-mode h-20 md:h-28 w-auto" />
        </div>
        {paragraphs.map((p) => (
          <p class="text-base md:text-lg leading-relaxed max-w-2xl opacity-70 mb-4">
            {p}
          </p>
        ))}
      </div>
      {still && (
        <figure class="relative aspect-[4/3] rounded-xl overflow-hidden bg-black/5 order-first lg:order-last">
          <img
            src={`${base}${still.src}`}
            alt={getLocalizedString(still.alt, locale)}
            style={still.focal ? `object-position: ${still.focal};` : undefined}
            class="w-full h-full object-cover motion-safe:animate-[hero-zoom_18s_ease-out_forwards]"
            loading="lazy"
            decoding="async"
          />
        </figure>
      )}
    </div>
  </div>
</section>
