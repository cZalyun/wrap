---
import { siteConfig, getLocalizedString } from '../content/site.config';
import { type Locale } from '../i18n/utils';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const paragraphs = getLocalizedString(siteConfig.introText, locale).split('\n\n');
---

<section class="section-cream section-padding px-6 lg:px-8">
  <div class="mx-auto max-w-7xl reveal-on-scroll">
    <div class="mb-8">
      <img src={`${base}${siteConfig.logoDark}`} alt={siteConfig.brand} class="logo-light-mode h-20 md:h-28 w-auto hidden" />
      <img src={`${base}${siteConfig.logoLight}`} alt={siteConfig.brand} class="logo-dark-mode h-20 md:h-28 w-auto" />
    </div>
    {paragraphs.map((p) => (
      <p class="text-base md:text-lg leading-relaxed max-w-2xl opacity-70 mb-4">
        {p}
      </p>
    ))}
  </div>
</section>
